# Where subscriptions are sent.
#
# Google Apps Script: deploy the script from the README as a Web app with
# "Execute as: Me" and "Who has access: Anyone", then paste the /exec URL.
#
# VITE_SIGNUP_ENDPOINT=https://script.google.com/macros/s/AKfycb.../exec
#
# Any provider that accepts a POST of {"email": "..."} also works
# (Mailchimp, Klaviyo, Buttondown, Formspree, Netlify forms).
#
# Leave it unset and the form hands addresses to info@ziyaco.co.za instead,
# so nothing is ever collected and dropped.
VITE_SIGNUP_ENDPOINT=
